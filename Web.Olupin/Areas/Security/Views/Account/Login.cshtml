@model MOROPO.Framework.Guama.Core.Presentation.Web.Security.Models.View.LoginViewModel

@{
    const string TITLE = "Control de Acceso";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>ASISTEC S.R.L. - @TITLE</title>

    <link rel="stylesheet" type="text/css" href="/vendor/bootstrap/css/bootstrap.min.css" />

    <style type="text/css">
        html,
        body {
            height: 100%;
        }

        body {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-align: center;
            align-items: center;
            padding-top: 40px;
            padding-bottom: 40px;
            background-color: #f5f5f5;
            text-align: center;
            background-image: linear-gradient(305deg, rgba(254, 254, 254,0.02) 0%, rgba(254, 254, 254,0.02) 1%,transparent 1%, transparent 50%,rgba(220, 220, 220,0.02) 50%, rgba(220, 220, 220,0.02) 64%,rgba(249, 249, 249,0.02) 64%, rgba(249, 249, 249,0.02) 100%),linear-gradient(38deg, rgba(70, 70, 70,0.02) 0%, rgba(70, 70, 70,0.02) 35%,transparent 35%, transparent 62%,rgba(152, 152, 152,0.02) 62%, rgba(152, 152, 152,0.02) 74%,rgba(99, 99, 99,0.02) 74%, rgba(99, 99, 99,0.02) 100%),linear-gradient(337deg, rgba(124, 124, 124,0.02) 0%, rgba(124, 124, 124,0.02) 45%,transparent 45%, transparent 55%,rgba(34, 34, 34,0.02) 55%, rgba(34, 34, 34,0.02) 72%,rgba(189, 189, 189,0.02) 72%, rgba(189, 189, 189,0.02) 100%),linear-gradient(92deg, rgba(239, 239, 239,0.02) 0%, rgba(239, 239, 239,0.02) 12%,transparent 12%, transparent 22%,rgba(204, 204, 204,0.02) 22%, rgba(204, 204, 204,0.02) 51%,rgba(70, 70, 70,0.02) 51%, rgba(70, 70, 70,0.02) 100%),linear-gradient(90deg, rgb(255,255,255),rgb(255,255,255));
        }

        .form-signin {
            width: 100%;
            max-width: 330px;
            padding: 15px;
            margin: auto;
        }

            .form-signin .checkbox {
                font-weight: 400;
            }

            .form-signin .form-control {
                position: relative;
                box-sizing: border-box;
                height: auto;
                padding: 10px;
                font-size: 16px;
            }

                .form-signin .form-control:focus {
                    z-index: 2;
                }

            .form-signin #UserName {
                margin-bottom: -1px;
                border-bottom-right-radius: 0;
                border-bottom-left-radius: 0;
            }

            .form-signin #Password {
                margin-bottom: 10px;
                border-top-left-radius: 0;
                border-top-right-radius: 0;
            }
    </style>

</head>

<body id="page-top">

    @using (Html.BeginForm("login", "account", new { Area = "security", ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "form-signin" }))
    {
        @if (TempData[NotificationViewModel.DEFAULT_NOTIFICATION_MAP_KEY] != null)
        {
            var notification = Newtonsoft.Json.JsonConvert.DeserializeObject<NotificationViewModel>(TempData[NotificationViewModel.DEFAULT_NOTIFICATION_MAP_KEY].ToString());

            <div class="alert alert-@Html.Raw(notification.Type.ToString().ToLower())">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                @if (notification.Title != null)
                {
                    <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                }

                @if (notification.Message != null)
                {
                    @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer));
                }

                @if (notification.Messages != null)
                {
                    <ul>
                        @foreach (var item in notification.Messages)
                        {
                            <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                        }
                    </ul>
                }
            </div>
        }

        @Html.ValidationSummary(true)

        <h4 class="text-dark font-weight-bold">Administración del Sitio Web</h4>
        <h5 class="mt-3 mb-3">@TITLE</h5>

        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Usuario" })

        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Contraseña" })

        @if (Context.Session.Keys.Contains(MOROPO.Framework.Guama.Core.Presentation.Web.Security.Constants.HttpSessionMapKeys.CaptchaCodeKey))
        {
            <div style="margin:20px 0; text-align: left;">
                @Html.LabelFor(model => model.CaptchaCode, new { @class = "control-label", style = "text-align: left;" })
                <img class="img-thumbnail mb-2" src="@Url.Action("captcha")" width="180" height="60" />
                @Html.TextBoxFor(model => model.CaptchaCode, new { @class = "form-control", placeholder = "Entre aquí las 8 letras en la imagen" })
                @Html.ValidationMessageFor(model => model.CaptchaCode, null, new { @class = "text-danger" })
            </div>
        }

        <div class="checkbox mb-3">
            <label>
                @Html.CheckBoxFor(m => m.RememberMe) Recordarme
            </label>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Iniciar</button>
        <p class="mt-5 mb-3 text-muted">&copy; @DateTime.Now.Year</p>
    }
    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(document).on("click", "button[type='submit']", function (e) {
                if (!e.target.form) return;

                e.preventDefault();

                $(e.target.form).find("input").addClass('readonly', 'readonly');
                $(e.target.form).find("select").attr('readonly', 'readonly');
                $(e.target.form).find("button").attr('disabled', 'disabled');
                $(e.target.form).find("a.btn").attr('disabled', 'disabled');

                e.target.form.submit();
            });
        });
    </script>

</body>

</html>
