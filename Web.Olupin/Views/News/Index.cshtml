@{
    const string TITLE = "Noticias";

    ViewData["Title"] = TITLE;

    Layout = "_FrontendLayout";
}

@section styles
{
    <style type="text/css">
        #hero-main {
            min-height: 240px;
            background-image: url('/media/images/website.s_cover_default_image.jpg');
            background-position: 50% 0;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        #hero-main-vintage {
            background-image: url('/img/01_001.svg');
            background-position: bottom;
            background-size: 100% auto;
            background-repeat: no-repeat;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
        }
    </style>
}

<section id="hero-main">
    <div class="hero-fullsize-child hero-common-overlay"></div>
    <div id="hero-main-vintage" class="hero-fullsize-child hero-common-vintage"></div>
</section>

<div class="container">
    <h1 class="display-4 font-weight-normal">@TITLE</h1>
</div>

