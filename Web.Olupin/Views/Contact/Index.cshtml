@{
    const string TITLE = "Contacto";

    ViewData["Title"] = TITLE;

    Layout = "_FrontendLayout";
}

@section styles
{
    <link rel="stylesheet" href="~/vendor/leaflet/leaflet.css" />

    <style type="text/css">
        #hero-main {
            min-height: 240px;
            background-image: url('/media/images/website.s_cover_default_image.jpg');
            background-position: 50% 0;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        #hero-main-vintage {
            background-image: url('/img/01_001.svg');
            background-position: bottom;
            background-size: 100% auto;
            background-repeat: no-repeat;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
        }

        #map {
            height: 240px;
        }
    </style>
}

@section scripts
{
    <script type="text/javascript" src="~/vendor/leaflet/leaflet.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var map = L.map('map', {
                scrollWheelZoom: false
            }).setView([21.3792, -77.9184], 16);

            var baseLayer = new L.tileLayer('http://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);
        });
    </script>
}

<section id="hero-main" class="mb-3">
    <div class="hero-fullsize-child hero-common-overlay"></div>
    <div id="hero-main-vintage" class="hero-fullsize-child hero-common-vintage"></div>
    <div class="container" style="z-index: 1000;">
        <h1 class="display-4 font-weight-normal mb-0">@TITLE</h1>
    </div>
</section>

<section class="container">
    <p class="lead mb-5">¿Deseas conocer más sobre nuestros servicios? ¡Contáctanos! Nos encantará conversar contigo.</p>

    <div class="row">
        <div class="col-sm-6">
            <h2>Envíanos un mensaje</h2>
            <form>
                <label>Tu nombre:</label>
                <input type="text" name="name" class="form-control mb-3" />
                <label>Tu correo electrónico:</label>
                <input type="email" name="email" class="form-control mb-3" />
                <label>Tu número de teléfono (opcional):</label>
                <input type="tel" name="phone" class="form-control mb-3" />
                <label>Asunto:</label>
                <input type="text" name="subject" class="form-control mb-3" />
                <label>Mensaje:</label>
                <textarea name="message" rows="8" class="form-control mb-3"></textarea>

                <input type="submit" class="btn btn-primary" value="ENVIAR" />
            </form>
        </div>
        <div class="col-sm-6">
            <h2 class="mb-3">Dónde encontrarnos?</h2>
            <div class="card">
                <div id="map" class="card-img-top"></div>
                <div class="card-body">
                    <h4 class="card-title">Domicilio Social</h4>
                    <p class="card-text">Puedes acercarte a nuestras oficinas a recibir una atención personalizada por un equipo de excelentes expertos, que te ayudarán a encontrar la solución que está buscando.</p>
                    <div class="row no-gutters">
                        <div class="col-auto"><i class="fas fa-fw fa-map-marked"></i></div>
                        <div class="col ml-1">
                            <p>Calle Cristo número 70 entre San Antonio y Hospital, ciudad de Camagüey, República de Cuba</p>
                        </div>
                    </div>
                    <div class="row no-gutters">
                        <div class="col-auto"><i class="fas fa-fw fa-clock"></i></div>
                        <div class="col ml-1">
                            <p>De luines a viernes, de 8:00 AM a 4:00 PM</p>
                        </div>
                    </div>
                    <div class="row no-gutters">
                        <div class="col-auto">
                            <i class="fas fa-fw fa-phone"></i>
                        </div>
                        <div class="col ml-1">
                            <p><a href="tel:+5353201929" class="ml-1 text-dark">(+53) 5 320 1929</a></p>
                        </div>
                    </div>
                    <div class="row no-gutters">
                        <div class="col-auto">
                            <span class="fas fa-fw fa-envelope"></span>
                        </div> 
                        <div class="col ml-1">
                            <a href="mailto:contacto@asistec.cu" class="text-dark">contacto@asistec.cu</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>