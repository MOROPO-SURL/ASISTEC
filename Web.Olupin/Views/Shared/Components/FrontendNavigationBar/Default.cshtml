<div class="pb-3 fixed-top bg-white shadow-sm">
    <div class="container ">
        <div class="row">
            <div class="col-auto mt-2">
                <img title="ASISTEC S.R.L." src="/img/logo-200x200.jpg" style="height: 128px;" />
            </div>
            <div class="col mt-4">
                <div class="row align-items-center">
                    <div class="col-auto"><a href="tel:+5353201929"><i class="fas fa-fw fa-phone"></i> (+53) 5 320 1929</a></div>
                    <div class="col"><a href="mailto:contacto@asistec.cu"><span class="fas fa-fw fa-envelope"></span> contacto@asistec.cu</a></div>
                    <div class="col-auto">
                        <a class="mx-1" href="https://linkedin.com/asistec" target="_blank"><i class="fab fa-2x fa-linkedin"></i></a>
                        <a class="mx-1" href="https://instagram.com/asistec" target="_blank"><span class="fab fa-2x fa-instagram"></span></a>
                        <a class="mx-1" href="https://facebook.com/asistec" target="_blank"><span class="fab fa-2x fa-facebook"></span></a>
                    </div>
                </div>
                <hr />
                <ul class="nav nav-pills">
                    <li class="nav-item">
                        @if (Context.Request.Path.Value == "/")
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="home">Inicio</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="home">Inicio</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/about"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="about">Nosotros</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="about">Nosotros</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/services"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="services">Servicios</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="services">Servicios</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/products"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="products">Productos</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="products">Productos</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/solutions"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="solutions">Soluciones</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="solutions">Soluciones</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/news"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="news">Noticias</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="news">Noticias</a>
                        }
                    </li>
                    <li class="nav-item">
                        @if (Context.Request.Path.Value.StartsWith("/contact"))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="contact">Contacto</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="contact">Contacto</a>
                        }
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://tienda.asistec.moropo.cu" target="_blank"><i class="fas faw fa-shopping-bag mr-1"></i> Tienda</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
