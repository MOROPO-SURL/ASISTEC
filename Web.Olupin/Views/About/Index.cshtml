@model MOROPO.ASISTEC.Web.Olupin.Models.View.Frontend.AboutIndexViewModel

@{
    ViewData["Title"] = Model.IntroTextBlock.Title;

    Layout = "_FrontendLayout";
}

@section styles
{
    <style type="text/css">
        #hero-main {
            min-height: 240px;
            background-position: center;
            background-size: cover;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            @if (Model.HeaderIlustration != null)
            {
                @Html.Raw(string.Format("background-image: url('/media/images/{0}.{1}');", Model.HeaderIlustration.Image.Id, Model.HeaderIlustration.Image.Extension))
            }
        }

        #hero-main-vintage {
            background-image: url('/img/01_001.svg');
            background-position: bottom;
            background-size: 100% auto;
            background-repeat: no-repeat;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
        }
    </style>
}

<section id="hero-main">
    <div class="hero-fullsize-child hero-common-overlay"></div>
    <div id="hero-main-vintage" class="hero-fullsize-child hero-common-vintage"></div>
</section>

<section>
    <div class="container">
        <h1 class="display-3 font-weight-normal mb-4">@Model.IntroTextBlock.Title</h1>
        @if (!string.IsNullOrEmpty(Model.IntroTextBlock.Description))
        {
            <div class="mb-5">
                @Html.Raw(Model.IntroTextBlock.Description)
            </div>
        }

        @if (Model.Representatives.Length > 0)
        {
            <div class="text-center"><h1 class="mb-5">Representantes</h1></div>

            <div class="row mb-5">
                @foreach (var item in Model.Representatives)
                {
                    <div class="col-md-6 mb-3">
                        <div class="row">
                            <div class="col-4 mb-3">
                                @if (item.Image != null)
                                {
                                    <img class="img-thumbnail img-fluid rounded-circle" src="~/media/images/@item.Image.Id.@item.Image.Extension" />
                                }
                                else
                                {
                                    <img class="img-thumbnail img-fluid rounded-circle" src="~/img/default-person-picture.jpg" />
                                }
                            </div>
                            <div class="col-8">
                                <h4>@item.Fullname</h4>
                                <h5 class="text-secondary">@item.Position</h5>
                                <div>@Html.Raw(item.About)</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="bg-white">
    <div class="container py-5">        
        @if (Model.MissionIlustration == null)
        {
            <h1 class="mb-4">@Model.MissionTextBlock.Title</h1>

            <div>@Html.Raw(Model.MissionTextBlock.Description)</div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h1 class="mb-4">@Model.MissionTextBlock.Title</h1>

                    <div>@Html.Raw(Model.MissionTextBlock.Description)</div>
                </div>
                <div class="col-md-6">
                    <img class="img-fluid" src="~/media/images/@Model.MissionIlustration.Image.Id.@Model.MissionIlustration.Image.Extension" />
                </div>
            </div>
        }
    </div>
</section>

