@model MOROPO.ASISTEC.Web.Olupin.Models.View.Frontend.HomeIndexViewModel

@{ 
    Layout = "_FrontendLayout";
}

@section styles
{
    <style type="text/css">
        .hero-common {
            background-position: 50% 0;
            background-size: cover;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-around;
        }

        #hero-main {
            min-height: 720px;
            @if (Model.HeroIlustration != null)
            {
                @Html.Raw(string.Format("background-image: url('/media/images/{0}.{1}');", Model.HeroIlustration.Image.Id, Model.HeroIlustration.Image.Extension))
            }
        }

        #hero-feature {
            min-height: 720px;
            @if (Model.MainPromoIlustration != null)
            {
                @Html.Raw(string.Format("background-image: url('/media/images/{0}.{1}');", Model.MainPromoIlustration.Image.Id, Model.MainPromoIlustration.Image.Extension))
            }
        }

        .hero-fullsize-child {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
        }

        .hero-common-vintage {
            background-size: 100% auto;
            background-repeat: no-repeat;
        }

        #hero-main-vintage {
            background-image: url('/img/01_001.svg');
            background-position: bottom;
        }

        #hero-feature-vintage {
            background-image: url('/img/02_001.svg');
            background-position: top;
        }

        .hero-common-overlay {
            background-color: rgba(0, 0, 0, 0.5);
        }

        #partners-vintage {
            background-size: 100% auto;
            background-repeat: no-repeat;
            background-image: url('/img/04.svg');
            background-position: bottom;
            min-height: 480px;
        }

        #section-service-lines {
            background-size: 100% auto;
            background-repeat: no-repeat;
            background-image: url('/img/05.svg');
            background-position: top;
        }

        .reference-carousel-item {
            background-position: 50% 50%;
            background-size: cover;
            background-repeat: no-repeat;
            min-height: 360px;
        }

        .carousel-indicators > li {
            height: 8px;
        }
    </style>
}

